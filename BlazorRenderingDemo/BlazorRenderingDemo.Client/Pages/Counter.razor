@page "/counter"
@rendermode InteractiveAuto
@* @attribute [StreamRendering] *@

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<h3>Renderer: @RendererInfo.Name</h3>
<p>Status: @(RendererInfo.IsInteractive ? "Interactive" : "Not yet interactive")</p>
<p>Running on: @(OperatingSystem.IsBrowser() ? "Client (WASM)" : "Server")</p>

<hr class="my-3" />

<h3>Component Lifecycle Tracking</h3>
<p class="text-muted"><small>Watch these counters update as you interact with the component!</small></p>

<div class="row">
    <div class="col-md-4">
        <div class="card border-primary mb-3">
       <div class="card-header bg-primary text-white">
  <strong>OnInitialized</strong>
     <span class="badge bg-light text-primary float-end">@onInitializedCount calls</span>
    </div>
            <div class="card-body">
     <p class="card-text">
          <small>Runs once when component is created</small><br />
            <strong>Last called:</strong> @lastOnInitialized
      </p>
      </div>
    </div>
    </div>
    
    <div class="col-md-4">
        <div class="card border-info mb-3">
            <div class="card-header bg-info text-white">
         <strong>OnParametersSet</strong>
    <span class="badge bg-light text-info float-end">@onParametersSetCount calls</span>
            </div>
            <div class="card-body">
       <p class="card-text">
             <small>Runs on init and when parameters change</small><br />
  <strong>Last called:</strong> @lastOnParametersSet
    </p>
     </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card border-success mb-3">
      <div class="card-header bg-success text-white">
       <strong>OnAfterRender</strong>
 <span class="badge bg-light text-success float-end">@onAfterRenderCount calls</span>
         </div>
<div class="card-body">
        <p class="card-text">
      <small>Runs after each render to DOM</small><br />
          <strong>Last called:</strong> @lastOnAfterRender
         </p>
            </div>
        </div>
    </div>
</div>

<hr class="my-3" />

<h3>Interactive Counter</h3>
<p role="status" class="fs-4"><strong>Current count: @currentCount</strong></p>

@if (RendererInfo.IsInteractive)
{
    <div class="btn-group" role="group">
        <button class="btn btn-primary" @onclick="IncrementCount">
       Instant Increment
 </button>
   <button class="btn btn-warning" @onclick="IncrementCountDelayed" disabled="@isDelayedCounterRunning">
          @if (isDelayedCounterRunning)
            {
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
  <span>Counting in 3 seconds...</span>
       }
         else
      {
 <span>Delayed Increment (3s)</span>
   }
 </button>
    </div>
    
    <div class="mt-3 alert alert-light">
        <p class="mb-1"><strong>What to observe:</strong></p>
      <ul class="mb-0">
            <li><strong>OnInitialized:</strong> Called once (count stays at 1)</li>
        <li><strong>OnParametersSet:</strong> Called once on init (would increment if InitialCount changed from parent)</li>
       <li><strong>OnAfterRender:</strong> Called after every UI update</li>
      <li><strong>Delayed button:</strong> Requires <code>StateHasChanged()</code> after async work</li>
        </ul>
    </div>
}
else
{
    <em>Waiting for interactivity, showing prerendered component's static HTML...</em>
}
