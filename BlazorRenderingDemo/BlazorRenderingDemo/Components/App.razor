<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorRenderingDemo.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    @* Applies the render mode to HeadOutlet so interactive 
       PageTitle/HeadContent updates use the same global interactivity. *@
    @* <HeadOutlet @rendermode="InteractiveAuto" /> *@
</head>

<body>
    <Routes />
    @* Applies InteractiveAuto globally to routed pages.
       Pages rendered through Routes inherit this interactive render mode
       instead of each page declaring its own @rendermode. *@
    @* <Routes @rendermode="InteractiveAuto" /> *@
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
